MYSQL_ROOT_PASSWORD=change-this-root-password
DB_NAME=spbgmu
DB_USER=spbgmu_app
DB_PASSWORD=change-this-app-password
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-this-admin-password
# Optional read-only administrator account, created on first database start.
VIEWER_LOGIN=observer
VIEWER_PASSWORD=change-this-viewer-password
COOKIE_SECURE=true

# Optional university SMTP. Leave blank until the system administrator configures it.
# Public base URL reachable from a student's email client (not an internal Docker hostname).
APP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
# Leave both blank only for a university relay authorised by source IP.
SMTP_USER=
SMTP_PASSWORD=
